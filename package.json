{
  "name": "catppuccin-markdown",
  "displayName": "Catppuccin Markdown Preview",
  "description": "Catppuccin Mocha styling for the built-in Markdown preview, with styled task-list checkboxes.",
  "version": "1.2.0",
  "publisher": "local",
  "repository": {
    "type": "git",
    "url": "https://github.com/cainux/catppuccin-markdown.git"
  },
  "engines": {
    "vscode": "^1.60.0"
  },
  "main": "./extension.js",
  "scripts": {
    "package": "npx --yes @vscode/vsce package --skip-license",
    "dev-install": "node scripts/dev-install.js"
  },
  "activationEvents": [
    "onLanguage:markdown"
  ],
  "contributes": {
    "markdown.previewStyles": [
      "./styles/catppuccin-mocha.css"
    ],
    "markdown.markdownItPlugins": true,
    "configurationDefaults": {
      "workbench.editorAssociations": {
        "*.md": "vscode.markdown.preview.editor"
      }
    }
  }
}
